# ============================================================
#  Large data & generated outputs — hosted externally, not in Git
#  (see the "Data Availability" section in README.md)
# ============================================================

# Raw and preprocessed omics data (TCGA) — too large for GitHub
data/rawdata/
data/processed_data/

# Large reference network / input files (> GitHub's 100 MB limit)
# These are REQUIRED to run the model — host them on Zenodo/figshare
# and document the download in README's Data Availability section.
data/STRINGv12.txt
data/9606.protein.links.v12.0.onlyAB.tsv

# Model outputs — keep ranking .txt files, ignore everything else
# (large intermediate objects like .Rdata are regenerated by the pipeline)
results/**
!results/
!results/**/
!results/**/*.txt

# Benchmark method run products (keep the source code, drop the data)
benchmark/PersonaDrive/graphs/
benchmark/**/*.gml
benchmark_cohort/NetWalkRank-main/Data/Results/
benchmark_cohort/DriverMP-master/DriverMP_example/Mutation_data.txt

# Catch-all: never commit any file >100 MB by accident.
# (Add specific paths above; this list is the safety net.)

# ============================================================
#  Editable design sources
# ============================================================
*.ai

# ============================================================
#  Editor / IDE config
# ============================================================
.vscode/
.idea/

# ============================================================
#  R session / project cruft
# ============================================================
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ============================================================
#  Logs & OS files
# ============================================================
*.log
*.tmp
.DS_Store
Thumbs.db